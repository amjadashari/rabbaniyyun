---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('articles')).filter(p=>p.data.published && p.data.language==='en').slice(0,6);
const sahaba=(await getCollection('sahabat')).slice(0,6);
---
<BaseLayout lang="en">
<section class="hero"><div class="wrap"><div class="eyebrow">Rabbaniyyun</div><h1>Read with clarity.<br/>Live with purpose.</h1><p>Qur'an, hadith, reflections, and ideas for Muslims trying to live with clarity and purpose.</p></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div><h2>Explore the Sahabat</h2><p>A chronological visual library, now connected to editable articles.</p></div><a href="/sahabat/">View all →</a></div><div class="grid">{sahaba.map(s=><a class="editorial-card" href={(s.data.section==='sahabiyah'?'/sahabiyah/':'/sahabat/')+s.data.slug+'/' }><div class="thumb"><img src={s.data.card_image} alt=""/></div><div class="body"><h3>{s.data.title}</h3><p>{s.data.excerpt}</p></div></a>)}</div></div></section>
</BaseLayout>
