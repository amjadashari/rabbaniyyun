---
import BaseLayout from '../../layouts/BaseLayout.astro';import { getCollection, render } from 'astro:content';export async function getStaticPaths(){const authors=await getCollection('authors');return authors.map(author=>({params:{slug:author.data.slug},props:{author}}));}const {author}=Astro.props;const {Content}=await render(author);const allS=await getCollection('sahabat');const allA=await getCollection('articles');const works=[...allS,...allA].filter(x=>(x.data.authors||[]).includes(author.data.slug));
---
<BaseLayout title={author.data.name}><section class="hero"><div class="wrap"><div class="eyebrow">Author</div><h1>{author.data.name}</h1><p>{author.data.bio}</p></div></section><section class="section"><div class="wrap"><div class="article"><Content/></div><h2>Writing</h2><div class="grid">{works.map(w=><a class="editorial-card" href={w.collection==='sahabat'?(w.data.section==='sahabiyah'?`/sahabiyah/${w.data.slug}/`:`/sahabat/${w.data.slug}/`):`/articles/${w.data.slug}/`}><div class="body"><h3>{w.data.title}</h3><p>{w.data.excerpt}</p></div></a>)}</div></div></section></BaseLayout>
