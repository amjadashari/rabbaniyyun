---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SahabatCard from '../../components/SahabatCard.astro';
import { getCollection } from 'astro:content';
const entries=(await getCollection('sahabat')).filter(x=>x.data.published).sort((a,b)=>(a.data.timeline_order||0)-(b.data.timeline_order||0));
const eras=[{"id": "early_makkah", "year": "610–613 CE", "title": "Islam terawal di Makkah", "desc": "Kelompok awal yang beriman pada tahun-tahun pertama dakwah.", "thumb": "/images/timeline/early_makkah.webp"}, {"id": "makkah", "year": "614–619 CE", "title": "Fasa Makkah & Hijrah Habasyah", "desc": "Dakwah semakin tersebar dan sebahagian sahabat berhijrah.", "thumb": "/images/timeline/makkah.webp"}, {"id": "pre_hijrah", "year": "620–622 CE", "title": "Ansar & pra-Hijrah", "desc": "Islam berkembang di Yathrib sebelum hijrah Rasulullah ﷺ.", "thumb": "/images/timeline/pre_hijrah.webp"}, {"id": "early_madinah", "year": "622–625 CE", "title": "Madinah awal", "desc": "Pembinaan masyarakat Madinah, Badar dan Uhud.", "thumb": "/images/timeline/early_madinah.webp"}, {"id": "mid_madinah", "year": "625–628 CE", "title": "Madinah pertengahan", "desc": "Fasa selepas Uhud hingga Hudaybiyyah dan Khaybar.", "thumb": "/images/timeline/mid_madinah.webp"}, {"id": "pre_conquest", "year": "628–629 CE", "title": "Pra-Pembukaan Makkah", "desc": "Beberapa tokoh besar menerima Islam sebelum pembukaan Makkah.", "thumb": "/images/timeline/pre_conquest.webp"}, {"id": "conquest", "year": "630 CE", "title": "Pembukaan Makkah", "desc": "Perubahan besar apabila ramai tokoh Quraysh dan Arab menerima Islam.", "thumb": "/images/timeline/conquest.webp"}, {"id": "late", "year": "630–632 CE", "title": "Tahun Delegasi & generasi akhir", "desc": "Kabilah-kabilah datang menerima Islam dan generasi muda membesar di bawah bimbingan Rasulullah ﷺ.", "thumb": "/images/timeline/late.webp"}];
---
<BaseLayout lang="my" title="Kronologi Para Sahabat">
<section class="hero"><div class="wrap"><div class="eyebrow">Sirah • Interactive Library</div><h1>Kronologi Para Sahabat</h1><p>Setiap kad kini ialah pintu masuk kepada artikel sendiri. Artikel, author, gambar dan metadata boleh disunting melalui CMS tanpa Blogger.</p></div></section>
<section class="section"><div class="wrap"><input id="personSearch" class="search-input" placeholder="Cari nama, peranan atau kategori…"/><div class="filters"><button class="filter-btn active" data-filter="all">Semua</button><button class="filter-btn" data-filter="male">Sahabat</button><button class="filter-btn" data-filter="female">Sahabiyah</button><button class="filter-btn" data-filter="jannah">Asharah</button><button class="filter-btn" data-filter="badr">Ahli Badr</button><button class="filter-btn" data-filter="ansar">Ansar</button><button class="filter-btn" data-filter="muhajir">Muhajirun</button></div>
{eras.map((era:any)=>{const list=entries.filter(e=>e.data.era===era.id);if(!list.length)return null;return <section class="timeline-section" data-era={era.id}><aside class="timeline-side"><img src={era.thumb} alt={era.title}/><div class="eyebrow">{era.year}</div><h2>{era.title}</h2><p>{era.desc}</p></aside><div class="sahaba-grid">{list.map(entry=><SahabatCard entry={entry} />)}</div></section>})}
</div></section>
<div id="floatingTip" class="floating-tip"></div>
<script is:inline>
(()=>{const q=document.getElementById('personSearch');const cards=[...document.querySelectorAll('.game-card')];const sections=[...document.querySelectorAll('.timeline-section')];let filter='all';function apply(){const s=(q?.value||'').toLowerCase();cards.forEach(c=>{const gender=c.dataset.gender;const badges=c.dataset.badges||'';const okF=filter==='all'||filter===gender||badges.includes(filter);const okS=!s||(c.dataset.search||'').includes(s);c.style.display=okF&&okS?'':'none'});sections.forEach(sec=>{sec.style.display=[...sec.querySelectorAll('.game-card')].some(c=>c.style.display!=='none')?'':'none'})}q?.addEventListener('input',apply);document.querySelectorAll('.filter-btn').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.filter-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');filter=b.dataset.filter;apply()}));const tip=document.getElementById('floatingTip');document.querySelectorAll('[data-tip]').forEach(el=>{el.addEventListener('mouseenter',()=>{tip.textContent=el.dataset.tip;tip.classList.add('show');const r=el.getBoundingClientRect();let left=r.left+r.width/2-tip.offsetWidth/2;left=Math.max(8,Math.min(innerWidth-tip.offsetWidth-8,left));let top=r.top-tip.offsetHeight-8;if(top<8)top=r.bottom+8;tip.style.left=left+'px';tip.style.top=top+'px'});el.addEventListener('mouseleave',()=>tip.classList.remove('show'))})})();
</script>
</BaseLayout>
